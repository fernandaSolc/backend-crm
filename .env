# Configurações do Projeto Contatos CRM
# ====================================

# Ambiente
NODE_ENV=development

# Portas
API_PORT=3001
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# Configurações do Banco de Dados
DB_HOST=database-infrastructure_postgres_1
DB_PORT=5432
DB_NAME=crm_juridico
DB_USER=crm_app_user
DB_PASSWORD=CrmAppSecurePass789!@#
DB_SSL=true

# Configurações de Segurança
JWT_SECRET=SuperSecretJWTKey123!@#
API_RATE_LIMIT=100
CORS_ORIGIN=http://localhost:3000

# Configurações do Frontend
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=CRM Contatos

# Configurações de Log
LOG_LEVEL=info
LOG_FORMAT=combined

# Configurações de Upload (futuro)
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# Configurações de Email (futuro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
